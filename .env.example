# Copy this file to a new file named '.env' and fill in your API keys.
# Do NOT commit your actual '.env' file containing secrets to version control.

# Groq API Key (Required for Groq chat models)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Access Token (Optional, for higher rate limits on Hugging Face Hub)
HF_TOKEN=your_hugging_face_token_here
